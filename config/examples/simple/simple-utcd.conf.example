# Simple UTC Daemon Configuration
# This is a basic configuration suitable for development and testing

# Network Configuration
listen_address = 0.0.0.0
listen_port = 37
enable_ipv6 = true
max_connections = 100

# UTC Server Configuration
stratum = 2
sync_interval = 64
timeout = 1000

# Logging Configuration
log_file = /var/log/simple-utcd/simple-utcd.log
log_level = INFO
enable_console_logging = true
enable_syslog = false

# Security Configuration
# RFC 868 has no authentication. Use allow/deny and the rate limit.
enable_authentication = false
restrict_queries = false
denied_clients = []
allowed_clients = []
enable_rate_limit = true
rate_limit_rps = 32
rate_limit_burst = 64
# Set these when starting as root. systemd can also set User= directly.
run_as_user =
run_as_group =

# Performance Configuration
worker_threads = 2
enable_statistics = true
stats_interval = 60

