<?xml version="1.0" encoding="UTF-8"?>
<CPackWiXPatch>
  <!-- CPack names the installed exe component CM_CP_bin.<name>.exe -->
  <CPackWiXFragment Id="CM_CP_bin.simple_utcd.exe">
    <ServiceInstall
      Id="SimpleUtcdServiceInstall"
      Name="simple-utcd"
      DisplayName="Simple UTC Daemon"
      Description="Provides RFC 868 UTC time"
      Type="ownProcess"
      Start="auto"
      ErrorControl="normal"
      Account="LocalSystem">
      <ServiceDependency Id="Tcpip"/>
    </ServiceInstall>
    <ServiceControl
      Id="SimpleUtcdServiceControl"
      Name="simple-utcd"
      Stop="both"
      Remove="uninstall"
      Wait="yes"/>
  </CPackWiXFragment>
</CPackWiXPatch>
